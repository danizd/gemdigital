# Exemplo de variables de entorno para o GDT-Santiago
# Copia este ficheiro a .env e completa cos valores reais

# --- PostGIS ---
POSTGRES_USER=gdt_user
POSTGRES_PASSWORD=cambia_este_password_seguro
POSTGRES_DB=gdt_santiago

# --- Tiles ---
# Version actual dos tiles (para invalidacion de cache)
TILES_VERSION=v1

# --- Despliegue ---
# Dominio de producion (Fase 2)
# GDT_DOMAIN=gemelo.movilab.es

# Entorno: development | production
NODE_ENV=development
